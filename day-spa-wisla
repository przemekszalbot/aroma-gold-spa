<script>
  // ---- Cookie consent PRO ----
  // Zapis w localStorage: { necessary: true, analytics: boolean, marketing: boolean, ts: number }
  const CONSENT_KEY = "agspa_cookie_consent_v1";

  function getConsent() {
    try { return JSON.parse(localStorage.getItem(CONSENT_KEY) || "null"); }
    catch { return null; }
  }

  function setConsent(consent) {
    localStorage.setItem(CONSENT_KEY, JSON.stringify({ ...consent, necessary: true, ts: Date.now() }));
    applyConsent();
    hideBanner();
  }

  function showBanner() {
    const wrap = document.getElementById("cookie-consent");
    wrap.style.display = "block";
    // fokus dla dostępności
    document.getElementById("cookie-accept").focus();
  }

  function hideBanner() {
    const wrap = document.getElementById("cookie-consent");
    wrap.style.display = "none";
  }

  function applyConsent() {
    const consent = getConsent();

    // Domyślnie: brak zgody na nie-niezbędne
    const analyticsOk = !!(consent && consent.analytics);
    const marketingOk = !!(consent && consent.marketing);

    // Tu w przyszłości podłączysz narzędzia:
    // - jeśli analyticsOk === true → ładuj Google Analytics
    // - jeśli marketingOk === true → ładuj Pixel / Ads
    //
    // Na dziś (gdy nie masz trackingów) nic nie musimy robić.
    // Dla porządku zostawiamy event do debugowania:
    window.dispatchEvent(new CustomEvent("cookieConsentUpdated", {
      detail: { necessary: true, analytics: analyticsOk, marketing: marketingOk }
    }));
  }

  // UI helpers
  function syncTogglesFromStored() {
    const consent = getConsent();
    document.getElementById("consent-analytics").checked = !!(consent && consent.analytics);
    document.getElementById("consent-marketing").checked = !!(consent && consent.marketing);
  }

  // Start
  document.addEventListener("DOMContentLoaded", () => {
    const stored = getConsent();
    if (!stored) {
      // brak decyzji → pokaż banner
      showBanner();
      syncTogglesFromStored();
    } else {
      // jest decyzja → zastosuj i nie pokazuj
      applyConsent();
      hideBanner();
    }

    // Buttons
    document.getElementById("cookie-accept").addEventListener("click", () => {
      setConsent({ analytics: true, marketing: true });
    });

    document.getElementById("cookie-reject").addEventListener("click", () => {
      setConsent({ analytics: false, marketing: false });
    });

    document.getElementById("cookie-save").addEventListener("click", () => {
      setConsent({
        analytics: document.getElementById("consent-analytics").checked,
        marketing: document.getElementById("consent-marketing").checked
      });
    });

    document.getElementById("cookie-close").addEventListener("click", () => {
      // zamknięcie bez zgody traktujemy jak odrzucenie (bezpieczne prawnie)
      setConsent({ analytics: false, marketing: false });
    });

    document.getElementById("cookie-open-settings").addEventListener("click", () => {
      // w tej wersji ustawienia są w samym bannerze (checkboxy),
      // więc tylko przewijamy fokus na pierwsze ustawienie
      document.getElementById("consent-analytics").focus();
    });

    // klik w tło też zamyka jak "odrzuć"
    document.getElementById("cookie-backdrop").addEventListener("click", () => {
      setConsent({ analytics: false, marketing: false });
    });
  });

  // (Opcjonalnie) funkcja do wywołania np. z linku w stopce:
  // <button onclick="openCookieSettings()">Ustawienia cookies</button>
  function openCookieSettings() {
    showBanner();
    syncTogglesFromStored();
  }
</script>

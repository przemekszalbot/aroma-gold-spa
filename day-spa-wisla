    a{color:inherit;text-decoration:none}
    .container{max-width:var(--max);margin:0 auto;padding:0 18px}

    /* NAV */
    .nav{
      position:sticky;top:0;z-index:50;
      backdrop-filter:saturate(150%) blur(10px);
      background:rgba(251,242,238,.72);
      border-bottom:1px solid var(--line);
    }
    .nav-inner{display:flex;align-items:center;justify-content:space-between;padding:12px 0;gap:14px}
    .brand{
      display:flex;align-items:center;gap:14px;
      font-weight:800;letter-spacing:.2px;min-width:260px;
    }
    .brand img{
      width:72px;height:72px;border-radius:18px;object-fit:cover;
      border:1px solid rgba(59,43,37,.10);
      background:#fff;
      box-shadow:0 14px 30px rgba(59,43,37,.12);
    }
    .brand .name{display:flex;flex-direction:column;line-height:1.08}
    .brand .name span:first-child{font-size:16px}
    .brand .name span:last-child{font-size:12px;color:var(--muted);font-weight:650;margin-top:6px}

    .nav-links{
      display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;align-items:center;
    }
    .nav-links a{
      color:var(--muted);
      padding:8px 10px;border-radius:12px;
      transition:.18s ease;border:1px solid transparent;font-weight:650;
    }
    .nav-links a:hover{
      color:var(--text);
      background:rgba(199,162,122,.12);
      border-color:rgba(199,162,122,.22);
    }

    /* Buttons */
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      padding:12px 16px;border-radius:14px;
      border:1px solid rgba(199,162,122,.45);
      background:linear-gradient(135deg, rgba(199,162,122,.26), rgba(215,184,177,.22));
      color:var(--text);
      box-shadow:0 12px 26px rgba(59,43,37,.10);
      transition:transform .16s ease,border-color .16s ease,background .16s ease;
      cursor:pointer;font-weight:800;white-space:nowrap;
    }
    .btn:hover{transform:translateY(-1px);border-color:rgba(181,138,110,.55)}
    .btn.secondary{
      border:1px solid var(--line);
      background:rgba(255,255,255,.65);
      box-shadow:none;font-weight:800;
    }
    .btn.secondary:hover{background:rgba(255,255,255,.9)}
    .btn.nav-cta{
      padding:10px 14px;
      border-radius:999px;
    }

    /* Icons */
    .icon{width:16px;height:16px;display:inline-block;vertical-align:-3px}

    .social{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    .social a{
      display:inline-flex;align-items:center;gap:8px;
      padding:8px 12px;border-radius:999px;
      border:1px solid rgba(181,138,110,.22);
      background:rgba(255,255,255,.72);
      color:var(--muted);
      font-weight:800;font-size:14px;
      transition:.15s ease;
    }
    .social a:hover{background:rgba(215,184,177,.20);border-color:rgba(181,138,110,.35);color:var(--text)}

    /* HERO */
    .hero{padding:52px 0 22px;position:relative;overflow:hidden}
    .hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px;align-items:stretch}
    @media (max-width: 980px){
      .hero-grid{grid-template-columns:1fr}
      .brand{min-width:unset}
      .brand img{width:62px;height:62px}
    }

    .hero-card{
      border:1px solid var(--line);
      border-radius:24px;
      background:
        radial-gradient(900px 420px at 15% 0%, rgba(215,184,177,.55), transparent 60%),
        rgba(255,255,255,.78);
      box-shadow:var(--shadow);
      padding:26px;
    }
    .badge{
      display:inline-flex;gap:10px;align-items:center;
      padding:7px 12px;border-radius:999px;
      border:1px solid rgba(181,138,110,.30);
      background:rgba(215,184,177,.18);
      font-weight:850;letter-spacing:.2px;margin-bottom:14px;
    }
    .hero h1{
      margin:0 0 10px;
      font-size:clamp(28px, 4vw, 46px);
      line-height:1.08;letter-spacing:-.5px;
    }
    .hero p{margin:0 0 12px;color:var(--muted);max-width:75ch}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}
    .note{font-size:13px;color:var(--muted);margin-top:12px}

    .info-card{
      border:1px solid var(--line);
      border-radius:24px;
      background:rgba(255,255,255,.75);
      box-shadow:var(--shadow);
      padding:20px;
      display:flex;
      flex-direction:column;
      gap:14px;
    }
    .info-card h3{margin:0 0 10px;font-size:18px}
    .list{margin:0;padding-left:18px;color:var(--muted)}
    .list li{margin:8px 0}
    .small{color:var(--muted);font-size:14px}

    /* SECTIONS */
    .section{padding:26px 0}
    .section-title{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:0 0 14px}
    .section-title h2{margin:0;font-size:26px;letter-spacing:-.2px}
    .section-title p{margin:0;color:var(--muted);max-width:74ch}

    .card{
      border:1px solid var(--line);
      border-radius:var(--radius);
      background:rgba(255,255,255,.75);
      padding:18px;
      box-shadow:0 16px 36px rgba(59,43,37,.10);
    }
    .card h3{margin:0 0 6px;font-size:18px}
    .card p{margin:0;color:var(--muted)}

    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media (max-width: 980px){ .grid-3{grid-template-columns:1fr} }

    .tag{
      display:inline-flex;
      padding:6px 10px;border-radius:999px;
      border:1px solid rgba(181,138,110,.22);
      background:rgba(215,184,177,.18);
      color:var(--muted);
      font-size:13px;margin-top:10px;font-weight:750;
    }

    /* CTA */
    .cta{
      border:1px solid rgba(181,138,110,.22);
      background:
        radial-gradient(800px 260px at 20% 0%, rgba(215,184,177,.40), transparent 60%),

    :root{
      --bg:#fbf2ee;
      --surface:#fffaf7;
      --surface2:#fff2ed;

      --text:#3b2b25;
      --muted:#7a5f56;
      --line:rgba(59,43,37,.12);

      --accent:#c7a27a;
      --accent2:#d7b8b1;
      --accent3:#b58a6e;

      --shadow:0 18px 45px rgba(59,43,37,.12);

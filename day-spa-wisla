      padding:18px;
      box-shadow:var(--shadow);
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      align-items:center;
      justify-content:space-between;
    }
    .cta strong{font-size:18px}

    /* TABS: Oferta / Cennik */
    .tabs{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0 14px}
    .tab-btn{
      padding:12px 18px;
      border-radius:999px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.86);
      color:var(--muted);
      font-weight:950;
      cursor:pointer;
      transition:.15s ease;
      box-shadow:0 10px 22px rgba(59,43,37,.07);
    }
    .tab-btn[aria-selected="true"]{
      color:var(--text);
      border-color:rgba(181,138,110,.45);
      background:rgba(215,184,177,.26);
    }
    .tab-panel[hidden]{display:none!important}

    /* PRICING */
    .pricing-wrap{display:grid;grid-template-columns:1fr;gap:12px}
    .table-scroll{overflow:auto;-webkit-overflow-scrolling:touch;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,85)}
    .table-scroll table{min-width:720px}
    .toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin:12px 0 10px}
    .chips{display:flex;gap:8px;flex-wrap:wrap}
    .chip{
      padding:8px 12px;border-radius:999px;border:1px solid var(--line);
      background:rgba(255,255,255,.75);
      color:var(--muted);
      cursor:pointer;
      transition:.15s ease;
      font-weight:900;
      font-size:14px;
    }
    .chip[aria-pressed="true"]{
      color:var(--text);
      border-color:rgba(181,138,110,.38);
      background:rgba(215,184,177,.22);
    }
    .search{
      width:min(420px, 100%);
      padding:10px 12px;border-radius:14px;border:1px solid var(--line);
      background:rgba(255,255,255,.85);
      color:var(--text);
      outline:none;
    }

    table{
      width:100%;
      border-collapse:separate;border-spacing:0;
      overflow:hidden;border-radius:var(--radius);
      border:1px solid var(--line);
      background:rgba(255,255,255,.78);
      box-shadow:0 16px 36px rgba(59,43,37,.10);
    }
    th,td{padding:14px 14px;border-bottom:1px solid var(--line);vertical-align:top}
    th{
      font-size:13px;text-transform:uppercase;letter-spacing:.08em;
      color:var(--muted);
      background:rgba(255,255,255,.75);
    }
    tr:last-child td{border-bottom:none}
    .price{white-space:nowrap;font-weight:900}
    .muted{color:var(--muted)}

    /* REVIEWS CAROUSEL */
    .reviews-wrap{
      border:1px solid var(--line);
      border-radius:18px;
      background:rgba(255,255,255,.78);
      padding:14px;
    }
    .reviews-head{
      display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
      margin-bottom:10px;
    }
    .stars{letter-spacing:.08em;font-weight:900;color:#a57c5f}
    .review-viewport{
      position:relative;
      overflow:hidden;
      border-radius:16px;
      border:1px solid rgba(59,43,37,.10);
      background:rgba(255,255,255,.65);
    }
    .review-track{
      display:flex;
      transition: transform .35s ease;
      will-change: transform;
    }
    .review{
      min-width:100%;
      padding:14px;
    }
    .review .top{
      display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
    }
    .review .who{
      font-weight:950;
      color:var(--text);
    }
    .review .src{
      font-size:12px;
      color:var(--muted);
      font-weight:900;
      padding:4px 8px;
      border-radius:999px;
      border:1px solid rgba(181,138,110,.22);
      background:rgba(215,184,177,.14);
      white-space:nowrap;
    }
    .review p{
      margin:10px 0 0;
      color:var(--muted);
      font-size:14px;
    }
    .review-controls{
      display:flex;align-items:center;justify-content:space-between;gap:10px;
      margin-top:10px;
    }
    .rev-btn{
      width:38px;height:38px;
      display:inline-flex;align-items:center;justify-content:center;
      border-radius:12px;
      border:1px solid rgba(181,138,110,.25);
      background:rgba(255,255,255,.82);
      cursor:pointer;
      font-weight:950;
      color:var(--muted);
      transition:.15s ease;
    }
    .rev-btn:hover{
      background:rgba(215,184,177,.18);
      color:var(--text);
      border-color:rgba(181,138,110,.35);
    }
    .dots{display:flex;gap:6px;align-items:center;justify-content:center;flex:1}
    .dot{
      width:8px;height:8px;border-radius:999px;
      border:1px solid rgba(181,138,110,.35);
      background:rgba(181,138,110,.10);
      cursor:pointer;
    }
    .dot[aria-current="true"]{
      background:rgba(181,138,110,.55);
    }
    .review-actions{
      display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;
    }
    .review-hint{font-size:12px;color:var(--muted);margin-top:8px}

    /* GALLERY */
    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media (max-width: 980px){ .gallery{grid-template-columns:1fr} }
    .photo{
      position:relative;overflow:hidden;border-radius:20px;border:1px solid var(--line);
      box-shadow:0 16px 36px rgba(59,43,37,.10);
      background:rgba(255,255,255,.78);
      min-height:260px;
    }
    .photo img{
      width:100%;height:100%;display:block;object-fit:cover;
      transform:scale(1.02);
      transition:transform .35s ease;
      filter:saturate(1.02) contrast(1.02);
    }
    .photo:hover img{transform:scale(1.06)}
    .overlay{
      position:absolute;inset:auto 0 0 0;
      padding:14px 14px 12px;
      background:linear-gradient(180deg, transparent, rgba(59,43,37,.60));
      color:#fff;
    }
    .overlay strong{display:block;font-size:16px;letter-spacing:.2px}
    .overlay span{display:block;font-size:13px;opacity:.92;margin-top:4px}

    /* CONTACT + MAP */
    .cols{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;align-items:start}
    @media (max-width: 900px){ .cols{grid-template-columns:1fr} }
    .contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    @media (max-width: 700px){ .contact-grid{grid-template-columns:1fr} }

    .map{
      border:1px solid var(--line);
      border-radius:20px;
      overflow:hidden;
      box-shadow:0 16px 36px rgba(59,43,37,.10);
      background:rgba(255,255,255,.78);
    }
    .map iframe{width:100%;height:320px;border:0;display:block}

    /* Footer */
    .footer{
      margin-top:28px;
      border-top:1px solid var(--line);
      padding:20px 0 34px;
      color:var(--muted);
      background:rgba(255,255,255,.45);
    }
  
    /* MOBILE FIX: iPhone — początek strony bez "wyjeżdżania" */
    @media (max-width: 520px){
      .container{padding:0 14px}
      .nav-inner{flex-wrap:wrap}
      .brand{min-width:unset}
      .nav-links{width:100%;justify-content:flex-start}
      .btn{white-space:normal}
      .hero-actions{flex-direction:column;align-items:stretch}
      .hero-actions .btn{width:100%}
      .note{overflow-wrap:anywhere;word-break:break-word}
    }

  
    /* DAY SPA (dodatkowe kafelki w Ofercie) */
    .day-spa{margin-top:18px}
    .day-spa h3{margin:0 0 10px;font-family:var(--serif);font-size:22px}
    .day-spa .lead{margin:0 0 14px;color:var(--muted);font-weight:650}
    .day-spa .card h4{margin:0 0 8px;font-family:var(--serif);font-size:18px}
    .day-meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;align-items:center;color:var(--muted);font-weight:750}
    .day-meta .pill{padding:6px 10px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.55)}
    .day-price s{opacity:.7}
    .day-price strong{color:var(--text)}
    .day-spa ul{margin:0;padding-left:18px}
    .day-spa li{margin:6px 0}

    /* Galeria: toggle panel */
    .gallery-head{display:flex;gap:12px;align-items:flex-end;justify-content:space-between;flex-wrap:wrap}

    /* Lightbox (powiększenie zdjęcia po kliknięciu) */
    .lightbox{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;padding:18px;z-index:2000}
    .lightbox.open{display:flex}
    .lightbox-card{max-width:980px;width:100%;background:#111;border-radius:18px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.12)}
    .lightbox-card img{width:100%;height:auto;display:block}
    .lightbox-bar{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px 14px;color:#fff;font-weight:800;background:rgba(0,0,0,.35)}
    .lightbox-close{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:999px;padding:10px 12px;cursor:pointer;font-weight:900}

    @media(max-width:980px){
      .day-spa h3{font-size:20px}
    }

  

    /* PODSTRONY SEO */
    .brand{color:inherit}
    .breadcrumbs{font-size:14px;color:var(--muted);margin-bottom:12px}
    .breadcrumbs a{text-decoration:underline;text-underline-offset:3px}
    .service-price{font-size:20px;font-weight:950;margin-top:12px;color:var(--text)}
    .service-card ul{margin:10px 0 0;padding-left:20px;color:var(--muted)}
    .service-card li{margin:6px 0}
    .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media(max-width:900px){.faq-grid{grid-template-columns:1fr}}
    .page-links{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
    .page-links a{text-decoration:underline;text-underline-offset:3px;font-weight:800;color:var(--accent3)}
    .service-hero-copy{font-size:17px}

  </style>
</head>

  <script>
    // Tabs (Oferta / Cennik)
    const tabOferta = document.getElementById("tab-oferta");
    const tabCennik = document.getElementById("tab-cennik");
    const panelOferta = document.getElementById("panel-oferta");
    const panelCennik = document.getElementById("panel-cennik");

    function showTab(which){
      const isOferta = which === "oferta";
      tabOferta.setAttribute("aria-selected", String(isOferta));
      tabCennik.setAttribute("aria-selected", String(!isOferta));
      panelOferta.hidden = !isOferta;
      panelCennik.hidden = isOferta;
      const target = (which === "cennik" && window.matchMedia("(max-width: 980px)").matches)
        ? document.querySelector("#panel-cennik .table-scroll") || panelCennik
        : document.getElementById("uslugi");
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    tabOferta.addEventListener("click", () => showTab("oferta"));
    tabCennik.addEventListener("click", () => showTab("cennik"));
    document.querySelectorAll('[data-switch-tab="cennik"]').forEach(btn => {
      btn.addEventListener("click", () => showTab("cennik"));
    });

    // Filtry + wyszukiwarka cennika
    const chips = Array.from(document.querySelectorAll(".chip"));
    const search = document.getElementById("search");
    const rows = Array.from(document.querySelectorAll("#pricingBody tr"));
    let activeCat = "all";

    function applyFilters(){
      const q = (search.value || "").trim().toLowerCase();
      rows.forEach(row => {
        const cat = row.getAttribute("data-cat");
        const text = row.innerText.toLowerCase();
        const okCat = (activeCat === "all") || (cat === activeCat);
        const okText = !q || text.includes(q);
        row.style.display = (okCat && okText) ? "" : "none";
      });
    }

    chips.forEach(chip => {
      chip.addEventListener("click", () => {
        chips.forEach(c => c.setAttribute("aria-pressed", "false"));
        chip.setAttribute("aria-pressed", "true");
        activeCat = chip.getAttribute("data-cat");
        applyFilters();
      });
    });
    if (search) search.addEventListener("input", applyFilters);

    // --- Opinie: karuzela ---
    const track = document.getElementById("reviewTrack");
    const slides = Array.from(track.children);
    const btnPrev = document.getElementById("revPrev");
    const btnNext = document.getElementById("revNext");
    const dotsWrap = document.getElementById("revDots");

    let idx = 0;
    let timer = null;
    const intervalMs = 5500;

    function renderDots(){
      dotsWrap.innerHTML = "";
      slides.forEach((_, i) => {
        const d = document.createElement("button");
        d.type = "button";
        d.className = "dot";
        d.setAttribute("aria-label", "Opinia " + (i + 1));
        d.setAttribute("aria-current", String(i === idx));
        d.addEventListener("click", () => { goTo(i); restart(); });
        dotsWrap.appendChild(d);
      });
    }

    function goTo(i){
      idx = (i + slides.length) % slides.length;
      track.style.transform = `translateX(-${idx * 100}%)`;
      Array.from(dotsWrap.children).forEach((d, j) => d.setAttribute("aria-current", String(j === idx)));
    }

    function next(){ goTo(idx + 1); }
    function prev(){ goTo(idx - 1); }

    function start(){
      timer = setInterval(() => next(), intervalMs);
    }
    function stop(){
      if (timer) clearInterval(timer);
      timer = null;
    }
    function restart(){
      stop();
      start();
    }

    btnNext.addEventListener("click", () => { next(); restart(); });
    btnPrev.addEventListener("click", () => { prev(); restart(); });

    // pauza przy najechaniu (desktop)
  
    // Galeria: show/hide (bez zmiany wyglądu — tylko zwijanie)
    const toggleGalleryBtn = document.getElementById("toggleGallery");
    const galleryPanel = document.getElementById("galleryPanel");
    if(toggleGalleryBtn && galleryPanel){
      // na telefonie domyślnie zwinięta
      if(window.matchMedia("(max-width: 980px)").matches){
        galleryPanel.hidden = true;
        toggleGalleryBtn.setAttribute("aria-expanded","false");
      }
      toggleGalleryBtn.addEventListener("click", () => {
        const isHidden = galleryPanel.hidden;
        galleryPanel.hidden = !isHidden;
        toggleGalleryBtn.setAttribute("aria-expanded", String(isHidden));
        if(isHidden){
          galleryPanel.scrollIntoView({behavior:"smooth", block:"start"});
        }
      });
    }

    // Lightbox dla zdjęć galerii
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightboxImg");
    const lightboxTitle = document.getElementById("lightboxTitle");
    const lightboxClose = document.getElementById("lightboxClose");

    function openLightbox(src, title, alt){
      if(!lightbox) return;
      lightboxImg.src = src;
      lightboxImg.alt = alt || title || "Zdjęcie";
      lightboxTitle.textContent = title || "Zdjęcie";
      lightbox.classList.add("open");
      lightbox.setAttribute("aria-hidden","false");
    }
    function closeLightbox(){
      if(!lightbox) return;
      lightbox.classList.remove("open");
      lightbox.setAttribute("aria-hidden","true");
      lightboxImg.src = "";
    }
    lightboxClose?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (e) => { if(e.target === lightbox) closeLightbox(); });
    window.addEventListener("keydown", (e) => { if(e.key === "Escape") closeLightbox(); });

    document.querySelectorAll("#galeria .photo img").forEach(img => {
      img.addEventListener("click", (e) => {
        e.preventDefault();
        const fig = img.closest("figure");
        const cap = fig?.querySelector(".overlay strong")?.textContent?.trim() || "";
        openLightbox(img.currentSrc || img.src, cap, img.alt);
      });
    });
  const viewport = track.parentElement;
    viewport.addEventListener("mouseenter", stop);
    viewport.addEventListener("mouseleave", start);

    renderDots();
    goTo(0);
    start();
  </script>


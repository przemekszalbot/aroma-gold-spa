  <style>
    :root{
      --bg:#fbf2ee;
      --surface:#fffaf7;
      --surface2:#fff2ed;

      --text:#3b2b25;
      --muted:#7a5f56;
      --line:rgba(59,43,37,.12);

      --accent:#c7a27a;
      --accent2:#d7b8b1;
      --accent3:#b58a6e;

      --shadow:0 18px 45px rgba(59,43,37,.12);
      --radius:18px;
      --max:1120px;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    html,body{overflow-x:hidden}
    *{min-width:0}
    img,svg,iframe{max-width:100%}
    body{
      margin:0;
      font:16px/1.65 system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      color:var(--text);
      background:
        radial-gradient(1000px 520px at 80% -10%, rgba(215,184,177,.55), transparent 60%),
        radial-gradient(900px 520px at 10% 10%, rgba(199,162,122,.35), transparent 60%),
        var(--bg);
    }

    a{color:inherit;text-decoration:none}
    .container{max-width:var(--max);margin:0 auto;padding:0 18px}

    /* NAV */
    .nav{
      position:sticky;top:0;z-index:50;
      backdrop-filter:saturate(150%) blur(10px);
      background:rgba(251,242,238,.72);
      border-bottom:1px solid var(--line);
    }
    .nav-inner{display:flex;align-items:center;justify-content:space-between;padding:12px 0;gap:14px}
    .brand{
      display:flex;align-items:center;gap:14px;
      font-weight:800;letter-spacing:.2px;min-width:260px;
    }
    .brand img{
      width:72px;height:72px;border-radius:18px;object-fit:cover;
      border:1px solid rgba(59,43,37,.10);
      background:#fff;
      box-shadow:0 14px 30px rgba(59,43,37,.12);
    }
    .brand .name{display:flex;flex-direction:column;line-height:1.08}
    .brand .name span:first-child{font-size:16px}
    .brand .name span:last-child{font-size:12px;color:var(--muted);font-weight:650;margin-top:6px}

    .nav-links{
      display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;align-items:center;
    }
    .nav-links a{
      color:var(--muted);
      padding:8px 10px;border-radius:12px;
      transition:.18s ease;border:1px solid transparent;font-weight:650;
    }
    .nav-links a:hover{
      color:var(--text);
      background:rgba(199,162,122,.12);
      border-color:rgba(199,162,122,.22);
    }

    /* Buttons */
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      padding:12px 16px;border-radius:14px;
      border:1px solid rgba(199,162,122,.45);
      background:linear-gradient(135deg, rgba(199,162,122,.26), rgba(215,184,177,.22));
      color:var(--text);
      box-shadow:0 12px 26px rgba(59,43,37,.10);
      transition:transform .16s ease,border-color .16s ease,background .16s ease;
      cursor:pointer;font-weight:800;white-space:nowrap;
    }
    .btn:hover{transform:translateY(-1px);border-color:rgba(181,138,110,.55)}
    .btn.secondary{
      border:1px solid var(--line);
      background:rgba(255,255,255,.65);
      box-shadow:none;font-weight:800;
    }
    .btn.secondary:hover{background:rgba(255,255,255,.9)}
    .btn.nav-cta{
      padding:10px 14px;
      border-radius:999px;
    }

    /* Icons */
    .icon{width:16px;height:16px;display:inline-block;vertical-align:-3px}

    .social{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    .social a{
      display:inline-flex;align-items:center;gap:8px;
      padding:8px 12px;border-radius:999px;
      border:1px solid rgba(181,138,110,.22);
      background:rgba(255,255,255,.72);
      color:var(--muted);
      font-weight:800;font-size:14px;
      transition:.15s ease;
    }
    .social a:hover{background:rgba(215,184,177,.20);border-color:rgba(181,138,110,.35);color:var(--text)}

    /* HERO */
    .hero{padding:52px 0 22px;position:relative;overflow:hidden}
    .hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px;align-items:stretch}
    @media (max-width: 980px){
      .hero-grid{grid-template-columns:1fr}
      .brand{min-width:unset}
      .brand img{width:62px;height:62px}
    }

    .hero-card{
      border:1px solid var(--line);
      border-radius:24px;
      background:
        radial-gradient(900px 420px at 15% 0%, rgba(215,184,177,.55), transparent 60%),
        rgba(255,255,255,.78);
      box-shadow:var(--shadow);
      padding:26px;
    }
    .badge{
      display:inline-flex;gap:10px;align-items:center;
      padding:7px 12px;border-radius:999px;
      border:1px solid rgba(181,138,110,.30);
      background:rgba(215,184,177,.18);
      font-weight:850;letter-spacing:.2px;margin-bottom:14px;
    }
    .hero h1{
      margin:0 0 10px;
      font-size:clamp(28px, 4vw, 46px);
      line-height:1.08;letter-spacing:-.5px;
    }
    .hero p{margin:0 0 12px;color:var(--muted);max-width:75ch}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}
    .note{font-size:13px;color:var(--muted);margin-top:12px}

    .info-card{
      border:1px solid var(--line);
      border-radius:24px;
      background:rgba(255,255,255,.75);
      box-shadow:var(--shadow);
      padding:20px;
      display:flex;
      flex-direction:column;
      gap:14px;
    }
    .info-card h3{margin:0 0 10px;font-size:18px}
    .list{margin:0;padding-left:18px;color:var(--muted)}
    .list li{margin:8px 0}
    .small{color:var(--muted);font-size:14px}

    /* SECTIONS */
    .section{padding:26px 0}
    .section-title{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:0 0 14px}
    .section-title h2{margin:0;font-size:26px;letter-spacing:-.2px}
    .section-title p{margin:0;color:var(--muted);max-width:74ch}

    .card{
      border:1px solid var(--line);
      border-radius:var(--radius);
      background:rgba(255,255,255,.75);
      padding:18px;
      box-shadow:0 16px 36px rgba(59,43,37,.10);
    }
    .card h3{margin:0 0 6px;font-size:18px}
    .card p{margin:0;color:var(--muted)}

    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media (max-width: 980px){ .grid-3{grid-template-columns:1fr} }

    .tag{
      display:inline-flex;
      padding:6px 10px;border-radius:999px;
      border:1px solid rgba(181,138,110,.22);
      background:rgba(215,184,177,.18);
      color:var(--muted);
      font-size:13px;margin-top:10px;font-weight:750;
    }

    /* CTA */
    .cta{
      border:1px solid rgba(181,138,110,.22);
      background:
        radial-gradient(800px 260px at 20% 0%, rgba(215,184,177,.40), transparent 60%),
        rgba(255,255,255,.76);
      border-radius:24px;
      padding:18px;
      box-shadow:var(--shadow);
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      align-items:center;
      justify-content:space-between;
    }
    .cta strong{font-size:18px}

    /* TABS: Oferta / Cennik */
    .tabs{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0 14px}
    .tab-btn{
      padding:12px 18px;
      border-radius:999px;
      border:1px solid var(--line);
      background:rgba(255,255,255,.86);
      color:var(--muted);
      font-weight:950;
      cursor:pointer;
      transition:.15s ease;
      box-shadow:0 10px 22px rgba(59,43,37,.07);
    }
    .tab-btn[aria-selected="true"]{
      color:var(--text);
      border-color:rgba(181,138,110,.45);
      background:rgba(215,184,177,.26);
    }
    .tab-panel[hidden]{display:none!important}

    /* PRICING */
    .pricing-wrap{display:grid;grid-template-columns:1fr;gap:12px}
    .table-scroll{overflow:auto;-webkit-overflow-scrolling:touch;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,85)}
    .table-scroll table{min-width:720px}
    .toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin:12px 0 10px}
    .chips{display:flex;gap:8px;flex-wrap:wrap}
    .chip{
      padding:8px 12px;border-radius:999px;border:1px solid var(--line);
      background:rgba(255,255,255,.75);
      color:var(--muted);
      cursor:pointer;
      transition:.15s ease;
      font-weight:900;
      font-size:14px;
    }
    .chip[aria-pressed="true"]{
      color:var(--text);
      border-color:rgba(181,138,110,.38);
      background:rgba(215,184,177,.22);
    }
    .search{
      width:min(420px, 100%);
      padding:10px 12px;border-radius:14px;border:1px solid var(--line);
      background:rgba(255,255,255,.85);
      color:var(--text);
      outline:none;
    }

    table{
      width:100%;
      border-collapse:separate;border-spacing:0;
      overflow:hidden;border-radius:var(--radius);
      border:1px solid var(--line);
      background:rgba(255,255,255,.78);
      box-shadow:0 16px 36px rgba(59,43,37,.10);
    }
    th,td{padding:14px 14px;border-bottom:1px solid var(--line);vertical-align:top}
    th{
      font-size:13px;text-transform:uppercase;letter-spacing:.08em;
      color:var(--muted);
      background:rgba(255,255,255,.75);
    }
    tr:last-child td{border-bottom:none}
    .price{white-space:nowrap;font-weight:900}
    .muted{color:var(--muted)}

    /* REVIEWS CAROUSEL */
    .reviews-wrap{
      border:1px solid var(--line);
      border-radius:18px;
      background:rgba(255,255,255,.78);
      padding:14px;
    }
    .reviews-head{
      display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
      margin-bottom:10px;
    }
    .stars{letter-spacing:.08em;font-weight:900;color:#a57c5f}
    .review-viewport{
      position:relative;
      overflow:hidden;
      border-radius:16px;
      border:1px solid rgba(59,43,37,.10);
      background:rgba(255,255,255,.65);
    }
    .review-track{
      display:flex;
      transition: transform .35s ease;
      will-change: transform;
    }
    .review{
      min-width:100%;
      padding:14px;
    }
    .review .top{
      display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
    }
    .review .who{
      font-weight:950;
      color:var(--text);
    }
    .review .src{
      font-size:12px;
      color:var(--muted);
      font-weight:900;
      padding:4px 8px;
      border-radius:999px;
      border:1px solid rgba(181,138,110,.22);
      background:rgba(215,184,177,.14);
      white-space:nowrap;
    }
    .review p{
      margin:10px 0 0;
      color:var(--muted);
      font-size:14px;
    }
    .review-controls{
      display:flex;align-items:center;justify-content:space-between;gap:10px;
      margin-top:10px;
    }
    .rev-btn{
      width:38px;height:38px;
      display:inline-flex;align-items:center;justify-content:center;
      border-radius:12px;
      border:1px solid rgba(181,138,110,.25);
      background:rgba(255,255,255,.82);
      cursor:pointer;
      font-weight:950;
      color:var(--muted);
      transition:.15s ease;
    }
    .rev-btn:hover{
      background:rgba(215,184,177,.18);
      color:var(--text);
      border-color:rgba(181,138,110,.35);
    }
    .dots{display:flex;gap:6px;align-items:center;justify-content:center;flex:1}
    .dot{
      width:8px;height:8px;border-radius:999px;
      border:1px solid rgba(181,138,110,.35);
      background:rgba(181,138,110,.10);
      cursor:pointer;
    }
    .dot[aria-current="true"]{
      background:rgba(181,138,110,.55);
    }
    .review-actions{
      display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;
    }
    .review-hint{font-size:12px;color:var(--muted);margin-top:8px}

    /* GALLERY */
    .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media (max-width: 980px){ .gallery{grid-template-columns:1fr} }
    .photo{
      position:relative;overflow:hidden;border-radius:20px;border:1px solid var(--line);
      box-shadow:0 16px 36px rgba(59,43,37,.10);
      background:rgba(255,255,255,.78);
      min-height:260px;
    }
    .photo img{
      width:100%;height:100%;display:block;object-fit:cover;
      transform:scale(1.02);
      transition:transform .35s ease;
      filter:saturate(1.02) contrast(1.02);
    }
    .photo:hover img{transform:scale(1.06)}
    .overlay{
      position:absolute;inset:auto 0 0 0;
      padding:14px 14px 12px;
      background:linear-gradient(180deg, transparent, rgba(59,43,37,.60));
      color:#fff;
    }
    .overlay strong{display:block;font-size:16px;letter-spacing:.2px}
    .overlay span{display:block;font-size:13px;opacity:.92;margin-top:4px}

    /* CONTACT + MAP */
    .cols{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;align-items:start}
    @media (max-width: 900px){ .cols{grid-template-columns:1fr} }
    .contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    @media (max-width: 700px){ .contact-grid{grid-template-columns:1fr} }

    .map{
      border:1px solid var(--line);
      border-radius:20px;
      overflow:hidden;
      box-shadow:0 16px 36px rgba(59,43,37,.10);
      background:rgba(255,255,255,.78);
    }
    .map iframe{width:100%;height:320px;border:0;display:block}

    /* Footer */
    .footer{
      margin-top:28px;
      border-top:1px solid var(--line);
      padding:20px 0 34px;
      color:var(--muted);
      background:rgba(255,255,255,.45);
    }
  
    /* MOBILE FIX: iPhone — początek strony bez "wyjeżdżania" */
    @media (max-width: 520px){
      .container{padding:0 14px}
      .nav-inner{flex-wrap:wrap}
      .brand{min-width:unset}
      .nav-links{width:100%;justify-content:flex-start}
      .btn{white-space:normal}
      .hero-actions{flex-direction:column;align-items:stretch}
      .hero-actions .btn{width:100%}
      .note{overflow-wrap:anywhere;word-break:break-word}
    }

  
    /* DAY SPA (dodatkowe kafelki w Ofercie) */
    .day-spa{margin-top:18px}
    .day-spa h3{margin:0 0 10px;font-family:var(--serif);font-size:22px}
    .day-spa .lead{margin:0 0 14px;color:var(--muted);font-weight:650}
    .day-spa .card h4{margin:0 0 8px;font-family:var(--serif);font-size:18px}
    .day-meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;align-items:center;color:var(--muted);font-weight:750}
    .day-meta .pill{padding:6px 10px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.55)}
    .day-price s{opacity:.7}
    .day-price strong{color:var(--text)}
    .day-spa ul{margin:0;padding-left:18px}
    .day-spa li{margin:6px 0}

    /* Galeria: toggle panel */
    .gallery-head{display:flex;gap:12px;align-items:flex-end;justify-content:space-between;flex-wrap:wrap}

    /* Lightbox (powiększenie zdjęcia po kliknięciu) */
    .lightbox{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;padding:18px;z-index:2000}
    .lightbox.open{display:flex}
    .lightbox-card{max-width:980px;width:100%;background:#111;border-radius:18px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.12)}
    .lightbox-card img{width:100%;height:auto;display:block}
    .lightbox-bar{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px 14px;color:#fff;font-weight:800;background:rgba(0,0,0,.35)}
    .lightbox-close{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:999px;padding:10px 12px;cursor:pointer;font-weight:900}

    @media(max-width:980px){
      .day-spa h3{font-size:20px}
    }

    /* SEO: czytelne linki do podstron usług */
    .seo-link{
      display:inline-flex;align-items:center;gap:6px;margin-top:12px;
      color:var(--accent3);font-weight:900;text-decoration:underline;
      text-decoration-thickness:1px;text-underline-offset:4px;
    }
    .seo-link:hover{color:var(--text)}
    .service-links{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}

  </style>

